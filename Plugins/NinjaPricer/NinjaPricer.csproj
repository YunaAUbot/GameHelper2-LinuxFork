<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NinjaPricer</AssemblyName>
    <RootNamespace>NinjaPricer</RootNamespace>
    <!-- Keep auxiliary sources/resources and nested build artifacts out of the plugin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**;tools/**;**/obj/**;**/bin/**</DefaultItemExcludes>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameHelperHostRoot Condition="Exists('$(MSBuildProjectDirectory)/../../GameHelper/GameHelper.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</GameHelperHostRoot>
    <GameHelperHostRoot Condition="'$(GameHelperHostRoot)' == ''">$(GAMEHELPER2_HOST_ROOT)</GameHelperHostRoot>
  </PropertyGroup>
  <Target Name="ValidateGameHelperHost" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameHelperHostRoot)' == ''" Text="Set GAMEHELPER2_HOST_ROOT or pass -p:GameHelperHostRoot=/path/to/GameHelper2." />
    <Error Condition="!Exists('$(GameHelperHostRoot)/GameHelper/GameHelper.csproj')" Text="GameHelper host project not found below '$(GameHelperHostRoot)'." />
  </Target>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="config\settings.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Localization/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(GameHelperHostRoot)/GameHelper/GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>
  <Target Name="RemoveHostAssemblies" AfterTargets="Build">
    <Delete Files="$(OutDir)GameHelper.dll;$(OutDir)GameHelper.pdb" />
  </Target>
  <Target Name="CopyFiles" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)/../../GameHelper/GameHelper.csproj')">
    <ItemGroup>
      <_PluginRuntimeFiles Include="$(TargetPath);$(TargetDir)$(AssemblyName).pdb;$(MSBuildProjectDirectory)/LICENSE;$(MSBuildProjectDirectory)/README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginRuntimeFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)/../../GameHelper/$(OutDir)Plugins/$(ProjectName)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
