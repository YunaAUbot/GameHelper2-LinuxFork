<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RendererPath Condition="'$(RendererPath)' == ''">../../renderer-src/ClickableTransparentOverlay/ClickableTransparentOverlay/bin/Release/net8.0/win-x64/ClickableTransparentOverlay.dll</RendererPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ClickableTransparentOverlay"><HintPath>$(RendererPath)</HintPath></Reference>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.5.0" />
  </ItemGroup>
</Project>
